<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground (adaptive icon, roadmap item 16): a map pin with a "fixme" exclamation
     mark. Canvas 108dp; the artwork stays inside the 66dp safe circle around (54,54) so no
     launcher mask clips it. Also the splash icon (themes.xml). The monochrome twin is
     ic_launcher_monochrome.xml; keep the geometry in sync. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Pin body (head r=19 at 54,44; tip at 54,80) with the exclamation mark punched out -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,80 C45,71 35,57 35,44 A19,19 0 1 1 73,44 C73,57 63,71 54,80 Z M50.5,35.5 A3.5,3.5 0 0 1 57.5,35.5 L57.5,45.5 A3.5,3.5 0 0 1 50.5,45.5 Z M50.5,54.5 A3.5,3.5 0 1 1 57.5,54.5 A3.5,3.5 0 1 1 50.5,54.5 Z" />
    <!-- The exclamation mark in the accent colour, filling the holes above -->
    <path
        android:fillColor="#FFFF5722"
        android:pathData="M50.5,35.5 A3.5,3.5 0 0 1 57.5,35.5 L57.5,45.5 A3.5,3.5 0 0 1 50.5,45.5 Z" />
    <path
        android:fillColor="#FFFF5722"
        android:pathData="M50.5,54.5 A3.5,3.5 0 1 1 57.5,54.5 A3.5,3.5 0 1 1 50.5,54.5 Z" />
</vector>
