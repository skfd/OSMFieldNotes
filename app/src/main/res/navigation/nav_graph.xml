<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.surveyme.presentation.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.surveyme.presentation.map.MapFragment"
        android:label="@string/navigation_map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/tracksFragment"
        android:name="com.surveyme.presentation.tracks.TracksFragment"
        android:label="@string/navigation_tracks"
        tools:layout="@layout/fragment_tracks" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.surveyme.presentation.settings.SettingsFragment"
        android:label="@string/navigation_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.surveyme.presentation.notes.NotesFragment"
        android:label="@string/navigation_notes"
        tools:layout="@layout/fragment_notes">
        <argument
            android:name="openPoiId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="openPoiTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="openPoiDescription"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Item 9: not a top-level destination, so the toolbar shows an Up arrow. -->
    <fragment
        android:id="@+id/triageFragment"
        android:name="com.surveyme.presentation.triage.TriageFragment"
        android:label="@string/navigation_triage"
        tools:layout="@layout/fragment_triage" />

    <!-- Item 11: the evidence review list, from the Home card. Not top-level: Up arrow. -->
    <fragment
        android:id="@+id/evidenceFragment"
        android:name="com.surveyme.presentation.evidence.EvidenceReviewFragment"
        android:label="@string/navigation_evidence"
        tools:layout="@layout/fragment_evidence_review" />

    <!-- Item 13: the muted-items list, from the Settings row. Not top-level: Up arrow. -->
    <fragment
        android:id="@+id/mutedItemsFragment"
        android:name="com.surveyme.presentation.muted.MutedItemsFragment"
        android:label="@string/navigation_muted"
        tools:layout="@layout/fragment_muted_items" />

</navigation>