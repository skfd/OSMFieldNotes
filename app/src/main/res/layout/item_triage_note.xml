<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            tools:text="Note 12345 · someone · 2026-09-24 10:31" />

        <TextView
            android:id="@+id/textText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBody1"
            tools:text="Is this shop still open? It looked closed last week." />

        <!-- Heuristic labels (item 8): what the guess is based on. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="2dp"
            tools:visibility="visible" />

        <!-- "Tagged #x" for a note that already carries a strict tag, "Pending: #x" while one is queued. -->
        <TextView
            android:id="@+id/textTagState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Pending: #surveyme"
            tools:visibility="visible" />

        <!-- One tap posts the tag as a comment; the guessed one is filled in its audience colour. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSurveyme"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#surveyme" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSurveyafter"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#surveyafter…" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipArmchair"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#armchair" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJosm"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#josm" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipChange"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/triage_change" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSkip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/triage_skip" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
